PORT=3000
APP_ENV=development
DB_PROVIDER=sqlite
SQLITE_PATH=./data/loja.db
# Para Azure App Service com Azure SQL, use DB_PROVIDER=sqlserver,
# configure estas variáveis nas Application Settings e prefira identidade gerenciada:
# AZURE_SQL_SERVER=servidor.database.windows.net
# AZURE_SQL_DATABASE=imersao
# AZURE_SQL_USER=usuario
# AZURE_SQL_PASSWORD=senha
# AZURE_SQL_AUTH=managedIdentity
# Com identidade gerenciada, não defina usuário ou senha.
AI_ENABLED=false
# AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
